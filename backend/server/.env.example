# Anvayra — Express backend

Copy to an environment that has the backend running, or rename from `.env.example`.

# Supabase project that owns the users (Supabase Auth is the identity provider).
SUPABASE_URL=https://nbxsebcrcussmmxismsa.supabase.co
# SERVER-ONLY. The service role key must NEVER be hard-coded anywhere the browser
# can read. Only this Node process uses it.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Where the static site lives (the API sits in front of /api/*; everything else is
# the static workspace). Used to redirect '/' and to build CORS/trusted origins.
APP_ORIGIN=https://anvayra.vercel.app
PORT=4000
